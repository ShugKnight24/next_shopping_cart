<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64">
  <defs>
    <linearGradient id="sapphire" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#1e3a5f" />
      <stop offset="100%" stop-color="#0f2744" />
    </linearGradient>
    <linearGradient id="gold" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#fce289" />
      <stop offset="50%" stop-color="#daa520" />
      <stop offset="100%" stop-color="#b8860b" />
    </linearGradient>
    <filter id="glow" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="0" dy="2" stdDeviation="1.5" flood-color="#000000" flood-opacity="0.35" />
    </filter>
  </defs>
  <!-- Background Badge -->
  <rect width="64" height="64" rx="16" fill="url(#sapphire)" />
  <rect x="1" y="1" width="62" height="62" rx="15" fill="none" stroke="url(#gold)" stroke-width="1.5" stroke-opacity="0.5" />

  <!-- Shopping Cart Icon -->
  <g filter="url(#glow)" transform="translate(6, 6)">
    <!-- Cart handle and basket -->
    <path d="M9 13h6l5.5 19.5a3 3 0 0 0 2.9 2.2h15.2a3 3 0 0 0 2.9-2.2L44.5 18H16" fill="none" stroke="url(#gold)" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round" />
    <!-- Wheels -->
    <circle cx="24.5" cy="41" r="3.5" fill="url(#gold)" />
    <circle cx="38.5" cy="41" r="3.5" fill="url(#gold)" />
    <!-- Center gem sparkle -->
    <polygon points="32,20 33.5,23.5 37,25 33.5,26.5 32,30 30.5,26.5 27,25 30.5,23.5" fill="#ffffff" opacity="0.9" />
  </g>
</svg>
